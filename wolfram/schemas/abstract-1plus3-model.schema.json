{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bass.master-ssot-v2.abstract-1plus3-model.v1",
  "title": "BASS Master SSOT v2 Abstract 1+3 Model Registry",
  "type": "object",
  "required": [
    "schema_version",
    "program_id",
    "stage_id",
    "manifold",
    "metric",
    "covariant_derivative",
    "normal",
    "spatial_projector",
    "spatial_volume_form",
    "acceleration",
    "extrinsic_curvature",
    "shear_split",
    "kinematic_decomposition",
    "scope"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "program_id": {
      "const": "BASS-MASTER-SSOT-V2-WOLFRAM-XACT-20260901"
    },
    "stage_id": {"const": "W2"},
    "manifold": {
      "type": "object",
      "required": ["symbol", "dimension"],
      "properties": {
        "symbol": {"const": "BASSW2M4"},
