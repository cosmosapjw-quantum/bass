    },
    "metric": {
      "type": "object",
      "required": ["symbol", "signature"],
      "properties": {
        "signature": {
          "type": "array",
          "prefixItems": [
            {"const": -1}, {"const": 1}, {"const": 1}, {"const": 1}
          ],
          "minItems": 4,
          "maxItems": 4
        }
      },
      "additionalProperties": true
    },
    "normal": {
      "type": "object",
      "required": ["symbol", "norm", "dimension", "hypersurface_orthogonal"],
      "properties": {
        "norm": {"const": -1},
        "hypersurface_orthogonal": {"const": true}
      },
      "additionalProperties": true
    },
    "spatial_projector": {"type": "object"},
    "spatial_volume_form": {"type": "object"},
    "acceleration": {"type": "object"},
    "extrinsic_curvature": {"type": "object"},
    "shear_split": {"type": "object"},
    "kinematic_decomposition": {"type": "object"},
    "scope": {"type": "object"}
