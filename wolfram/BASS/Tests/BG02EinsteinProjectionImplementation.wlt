ctx=Global`$BASSBG02EinsteinProjectionTestContext; r=Lookup[ctx,"registry",<||>]; a=Lookup[ctx,"audit",<||>];
VerificationTest[TrueQ@Lookup[ctx,"package_loaded",False],True,TestID->"load"]
VerificationTest[TrueQ@Lookup[ctx,"registry_valid",False],True,TestID->"registry"]
VerificationTest[Lookup[r,"formula_count",-1],14,TestID->"count"]
VerificationTest[DuplicateFreeQ@Lookup[Lookup[r,"formulas",{}],"formula_id",{}],True,TestID->"unique"]
VerificationTest[DeleteDuplicates@Lookup[Lookup[r,"formulas",{}],"dimension",{}],{"L^-2"},TestID->"dim"]
VerificationTest[TrueQ@Lookup[a,"dependency_graph_closed",False],True,TestID->"deps"]
VerificationTest[TrueQ@Lookup[a,"single_off_shell_residual_authority",False],True,TestID->"single"]
VerificationTest[Lookup[a,"hamiltonian_projection_residual",1],0,TestID->"H"]
VerificationTest[Lookup[a,"momentum_projection_residual",1],0,TestID->"M"]
VerificationTest[Lookup[a,"spatial_trace_projection_residual",1],0,TestID->"T"]
VerificationTest[Lookup[a,"spatial_pstf_projection_residual",1],0,TestID->"S"]
VerificationTest[Lookup[a,"adm_minus_trace_plus_half_hres",1],0,TestID->"AT"]
VerificationTest[Lookup[a,"trace_minus_ray_plus_sixth_hres",1],0,TestID->"TR"]
VerificationTest[Lookup[a,"adm_minus_ray_plus_two_thirds_hres",1],0,TestID->"AR"]
VerificationTest[Lookup[a,"shear_rate_adapter_residual",1],0,TestID->"shear"]
VerificationTest[Lookup[a,"flat_flrw_hamiltonian_residual",1],0,TestID->"flrwH"]
VerificationTest[Lookup[a,"flat_flrw_rate_residual",1],0,TestID->"flrwR"]
VerificationTest[Lookup[a,"flat_de_sitter_rate_residuals",{1}],{0,0,0},TestID->"dS"]
VerificationTest[Lookup[a,"kasner_hamiltonian_residual",1],0,TestID->"kasH"]
VerificationTest[Lookup[a,"kasner_rate_residuals",{1}],{0,0,0},TestID->"kasR"]
VerificationTest[Lookup[a,"bianchi_I_scalar_curvature_residual",1],0,TestID->"I"]
VerificationTest[Lookup[a,"bianchi_V_scalar_curvature_residual",1],0,TestID->"V"]
VerificationTest[Lookup[a,"bianchi_II_scalar_curvature_residual",1],0,TestID->"II"]
VerificationTest[Lookup[a,"bianchi_IX_scalar_curvature_residual",1],0,TestID->"IX"]
VerificationTest[And@@(TrueQ@Lookup[a,#,False]&/@{"wrong_connection_order_V_detected","wrong_connection_order_II_detected","I_IX_only_witness_set_rejected","second_koszul_implementation_absent"}),True,TestID->"order"]
VerificationTest[And[Lookup[a,"exceptional_VI_minus_one_ninth_residual",1]===0,TrueQ@Lookup[a,"sigma13_deletion_mutant_detected",False],TrueQ@Lookup[a,"normal_acceleration_distinct_from_bianchi_a",False],TrueQ@Lookup[a,"hamiltonian_surface_projection_absent",False]],True,TestID->"VI"]
