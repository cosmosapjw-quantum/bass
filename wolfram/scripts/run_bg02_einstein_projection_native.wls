#!/usr/bin/env wolframscript
(* Future GREEN native xTensor/xCoba replay. *)
ClearAll[jsonSafe]; jsonSafe[x_Association]:=AssociationThread[Keys[x],jsonSafe/@Values[x]]; jsonSafe[x_List]:=jsonSafe/@x; jsonSafe[x_String|x_Integer|x_Real|True|False|Null]:=x; jsonSafe[x_]:=ToString[InputForm[x]];
root=DirectoryName@DirectoryName@DirectoryName[$InputFileName]; out=If[Length@Rest[$ScriptCommandLine]>0,First@Rest[$ScriptCommandLine],FileNameJoin[{root,"artifacts","bg02_einstein_projection"}]]; If[!DirectoryQ[out],CreateDirectory[out,CreateIntermediateDirectories->True]];
init=FileNameJoin[{root,"wolfram","BASS","Kernel","init.wl"}]; mod=FileNameJoin[{root,"wolfram","BASS","Kernel","Background","EinsteinProjection.wl"}]; reg=FileNameJoin[{root,"docs","bass_master_ssot_v2","BG_02_IMPLEMENTATION","BG_02_IMPLEMENTATION_REGISTRY.json"}]; wlt=FileNameJoin[{root,"wolfram","BASS","Tests","BG02EinsteinProjectionImplementation.wlt"}]; rec=FileNameJoin[{out,"BG_02_EINSTEIN_PROJECTION_WOLFRAM_RECEIPT.json"}]; tmp=rec<>".tmp";
missing=Select[{init,mod,reg,wlt},!FileExistsQ[#]&]; If[missing=!={},Print@InputForm@<|"status"->"FAIL_MISSING_BG02_GREEN_INPUT","missing_paths"->missing|>;Exit[2]];
Get[init]; loaded=NameQ["BASS`Background`EinsteinProjectionRegistry"]&&NameQ["BASS`Background`EinsteinResidualTensor"]; xt=NameQ["xAct`xTensor`DefTensor"]||NameQ["DefTensor"]; xc=NameQ["xAct`xCoba`DefChart"]||NameQ["DefChart"]; registry=BASS`Background`EinsteinProjectionRegistry[]; audit=Lookup[registry,"native_audit",<||>]; valid=AssociationQ[registry]&&Lookup[registry,"formula_count",0]===14;
report=Block[{Global`$BASSBG02EinsteinProjectionTestContext=<|"package_loaded"->loaded,"registry_valid"->valid,"registry"->registry,"audit"->audit|>},TestReport[wlt]]; ok=loaded&&xt&&xc&&valid&&report["TestsSucceededCount"]===26&&report["TestsFailedCount"]===0&&report["TestsNotEvaluatedCount"]===0;
payload=jsonSafe@<|"schema_version"->"1.0.0","stage_id"->"BG_02_EINSTEIN_PROJECTION_NATIVE_XACT_REPLAY","xTensor_loaded"->xt,"xCoba_loaded"->xc,"TestsFailedCount"->report["TestsFailedCount"],"TestsNotEvaluatedCount"->report["TestsNotEvaluatedCount"],"tests_succeeded"->report["TestsSucceededCount"],"receipt_write_policy"->"TEMPORARY_FILE_STRICT_JSON_ROUND_TRIP_THEN_RENAME","status"->If[ok,"PASS_NATIVE_XACT_BG02_PROJECTION","FAIL_NATIVE_XACT_BG02_PROJECTION"]|>;
s=ExportString[payload,"RawJSON"]; Export[tmp,payload,"RawJSON"]; round=Import[tmp,"RawJSON"]; If[!AssociationQ[round],DeleteFile[tmp];Exit[3]]; RenameFile[tmp,rec]; Print@InputForm[payload]; Exit[If[ok,0,1]];
