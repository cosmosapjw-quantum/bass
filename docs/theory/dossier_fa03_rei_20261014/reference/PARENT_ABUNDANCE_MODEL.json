  "equations": [
    {
      "id": "ABF.1",
      "latex": "\\begin{gathered}\nN_s^a=n_su_s^a=D_sn^a+J_s^a,\n\\quad D_s=\\gamma_sn_s,\n\\quad J_s^a=D_s\\beta_s^a,\n\\quad n\\cdot J_s=0,\\\\\n\\gamma_s=(1-\\beta_s^2)^{-1/2},\n\\qquad \\nabla_aN_s^a=R_s/c,\n\\qquad \\nabla_aT_s^{ab}=Q_s^b/c .\n\\end{gathered}",
      "source_document": "derivation/DERIVATION_KO.md",
      "source_document_sha256": "7842931e332fcf7a4548e5741bd976f8d1d2e841971896bac0bc444d54dd1432"
    },
    {
      "id": "ABF.2",
      "latex": "\\boxed{\nB^a:=\\sum_sb_sN_s^a,\n\\qquad b_s\\ge0,\\qquad \\sum_sb_sn_s>0,\n\\qquad \\sum_sb_sR_s=0\n\\quad\\Longrightarrow\\quad \\nabla_aB^a=0.\n}",
      "source_document": "derivation/DERIVATION_KO.md",
      "source_document_sha256": "7842931e332fcf7a4548e5741bd976f8d1d2e841971896bac0bc444d54dd1432"
    },
    {
      "id": "ABF.3",
      "latex": "\\begin{gathered}\nD_B:=\\sum_sb_sD_s>0,\n\\qquad J_B:=\\sum_sb_sJ_s,\n\\qquad \\beta_B=J_B/D_B,\n\\qquad |\\beta_B|<1,\\\\\nn_B:=\\sqrt{-B^2}=D_B\\sqrt{1-\\beta_B^2},\n\\qquad \\gamma_B=D_B/n_B,\n\\qquad u_B=B/n_B=\\gamma_B(n+\\beta_B).\n\\end{gathered}",
      "source_document": "derivation/DERIVATION_KO.md",
      "source_document_sha256": "7842931e332fcf7a4548e5741bd976f8d1d2e841971896bac0bc444d54dd1432"
    },
    {
      "id": "ABF.4",
      "latex": "\\dot D_s=-3HD_s+2a_B\\cdot J_s+R_s/c,\n\\qquad\n\\dot D_B=-3HD_B+2a_B\\cdot J_B .",
      "source_document": "derivation/DERIVATION_KO.md",
      "source_document_sha256": "7842931e332fcf7a4548e5741bd976f8d1d2e841971896bac0bc444d54dd1432"
    },
    {
      "id": "ABF.5",
      "latex": "\\begin{gathered}\nY_s:=D_s/D_B,\n\\qquad F_s:=b_sY_s,\n\\qquad \\sum_sF_s=1,\\\\\nK_s^a:=N_s^a-Y_sB^a\n=J_s^a-Y_sJ_B^a\n=D_s(\\beta_s^a-\\beta_B^a),\n\\quad n\\cdot K_s=0,\n\\quad \\sum_sb_sK_s=0 .\n\\end{gathered}",
      "source_document": "derivation/DERIVATION_KO.md",
      "source_document_sha256": "7842931e332fcf7a4548e5741bd976f8d1d2e841971896bac0bc444d54dd1432"
    },
    {
      "id": "ABF.6",
      "latex": "\\boxed{\nB^a\\nabla_aY_s+\\nabla_aK_s^a=R_s/c.\n}\n\\qquad\nB^a\\nabla_aY_s=D_B\\dot Y_s,\n\\qquad \\nabla_aK_s^a=-2a_B\\cdot K_s\n\\quad\\text{(homogeneous normal)} .",
      "source_document": "derivation/DERIVATION_KO.md",
      "source_document_sha256": "7842931e332fcf7a4548e5741bd976f8d1d2e841971896bac0bc444d54dd1432"
    },
    {
      "id": "ABF.7",
      "latex": "\\boxed{\n\\dot Y_s\n=\\frac{R_s}{cD_B}\n +\\frac{2a_B\\cdot(J_s-Y_sJ_B)}{D_B}\n=\\frac{R_s}{cD_B}\n +2Y_s a_B\\cdot(\\beta_s-\\beta_B),\n\\qquad\n\\sum_sb_s\\dot Y_s=0 .\n}",
      "source_document": "derivation/DERIVATION_KO.md",
      "source_document_sha256": "7842931e332fcf7a4548e5741bd976f8d1d2e841971896bac0bc444d54dd1432"
    },
    {
      "id": "ABF.8",
      "latex": "\\boxed{\n\\begin{gathered}\nr_s:=\\frac{n_s}{n_B}=\\frac{\\gamma_B}{\\gamma_s}Y_s,\n\\qquad n_*:=\\sum_sb_sn_s,\n\\qquad X_s:=\\frac{b_sn_s}{n_*},\n\\quad \\sum_sX_s=1,\\\\\nS_\\gamma:=\\sum_r\\frac{b_rY_r}{\\gamma_r}=\\frac{n_*}{D_B},\n\\qquad X_s=\\frac{b_sY_s/\\gamma_s}{S_\\gamma},\n\\qquad \\chi_*:=\\frac{n_*}{n_B}=\\gamma_BS_\\gamma .\n\\end{gathered}\n}",
      "source_document": "derivation/DERIVATION_KO.md",
      "source_document_sha256": "7842931e332fcf7a4548e5741bd976f8d1d2e841971896bac0bc444d54dd1432"
    },
    {
      "id": "ABF.9",
      "latex": "\\begin{gathered}\n\\Gamma_{sr}:=-u_s\\cdot u_r\n=\\gamma_s\\gamma_r(1-\\beta_s\\cdot\\beta_r),\\\\\nn_B^2=\\sum_{s,r}b_sb_rn_sn_r\\Gamma_{sr},\n\\qquad n_B\\ge n_* ,\n\\qquad \\sum_sb_s\\Gamma_{sB}r_s=1,\\\\\n\\overline\\gamma_X:=\\sum_s\\gamma_sX_s,\n\\qquad F_s=\\frac{\\gamma_sX_s}{\\overline\\gamma_X},\n\\qquad D_B=n_*\\overline\\gamma_X .\n\\end{gathered}",
      "source_document": "derivation/DERIVATION_KO.md",
      "source_document_sha256": "7842931e332fcf7a4548e5741bd976f8d1d2e841971896bac0bc444d54dd1432"
    },
    {
      "id": "ABF.10",
      "latex": "\\begin{gathered}\n\\eta_s:=2a_B\\cdot\\beta_s-\\dot{\\ln\\gamma_s},\n\\qquad \\langle\\eta\\rangle_X:=\\sum_sX_s\\eta_s,\n\\qquad \\Xi:=\\sum_s\\frac{b_sR_s}{\\gamma_s},\\\\\n\\dot n_s=n_s(-3H+\\eta_s)+\\frac{R_s}{c\\gamma_s},\n\\qquad\n\\dot n_*=n_*(-3H+\\langle\\eta\\rangle_X)+\\Xi/c,\\\\\n\\frac{\\dot n_B}{n_B}=-3H+2a_B\\cdot\\beta_B-\\dot{\\ln\\gamma_B}.\n\\end{gathered}",
      "source_document": "derivation/DERIVATION_KO.md",
      "source_document_sha256": "7842931e332fcf7a4548e5741bd976f8d1d2e841971896bac0bc444d54dd1432"
    },
    {
      "id": "ABF.11",
      "latex": "\\boxed{\n\\dot r_s=\n\\frac{R_s}{c\\gamma_sn_B}\n+r_s\\left[\n2a_B\\cdot(\\beta_s-\\beta_B)\n+\\dot{\\ln\\gamma_B}-\\dot{\\ln\\gamma_s}\n\\right].\n}",
      "source_document": "derivation/DERIVATION_KO.md",
      "source_document_sha256": "7842931e332fcf7a4548e5741bd976f8d1d2e841971896bac0bc444d54dd1432"
    },
    {
      "id": "ABF.12",
      "latex": "\\boxed{\n\\dot X_s\n=X_s(\\eta_s-\\langle\\eta\\rangle_X)\n+\\frac{b_sR_s/\\gamma_s-X_s\\Xi}{cn_*},\n\\qquad \\sum_s\\dot X_s=0 .\n}",
      "source_document": "derivation/DERIVATION_KO.md",
      "source_document_sha256": "7842931e332fcf7a4548e5741bd976f8d1d2e841971896bac0bc444d54dd1432"
    },
    {
      "id": "ABF.13",
      "latex": "\\boxed{\n\\begin{gathered}\nz_s:=\\frac{-u_s\\cdot N_s}{-u_s\\cdot B}\n=\\frac{r_s}{\\Gamma_{sB}},\n\\qquad \\mathscr D_s:=c\\,u_s\\cdot\\nabla=c\\gamma_s\\frac{d}{ds}\n\\quad\\text{(homogeneous scalar)},\\\\\n\\mathscr D_sz_s\n=\\frac{R_s}{\\Gamma_{sB}n_B}\n+c\\gamma_sz_s\\left[\n2a_B\\cdot(\\beta_s-\\beta_B)\n+\\dot{\\ln\\gamma_B}-\\dot{\\ln\\gamma_s}\n-\\dot{\\ln\\Gamma_{sB}}\n\\right].\n\\end{gathered}\n}",
      "source_document": "derivation/DERIVATION_KO.md",
      "source_document_sha256": "7842931e332fcf7a4548e5741bd976f8d1d2e841971896bac0bc444d54dd1432"
    },
    {
      "id": "ABF.14",
      "latex": "\\begin{gathered}\nY_s^{(B)}:=\\frac{-u_B\\cdot N_s}{n_B}\n=\\Gamma_{sB}r_s,\n\\qquad\nj_s^{(B)a}:=N_s^a-Y_s^{(B)}B^a\n=n_s(u_s^a-\\Gamma_{sB}u_B^a),\\\\\nu_B\\cdot j_s^{(B)}=0,\n\\qquad \\sum_sb_sj_s^{(B)}=0,\n\\qquad \\sum_sb_sY_s^{(B)}=1.\n\\end{gathered}",
      "source_document": "derivation/DERIVATION_KO.md",
      "source_document_sha256": "7842931e332fcf7a4548e5741bd976f8d1d2e841971896bac0bc444d54dd1432"
    },
    {
      "id": "ABF.15",
      "latex": "\\boxed{\n\\begin{gathered}\nn_Bu_B^a\\nabla_aY_s^{(B)}+\\nabla_aj_s^{(B)a}=R_s/c,\\\\\n\\mathscr D_BY_s^{(B)}\n=\\frac{R_s-c[D^{(B)}_aj_s^{(B)a}\n+\\mathfrak a_{(B)a}j_s^{(B)a}]}{n_B},\n\\qquad \\mathscr D_B=c\\,u_B\\cdot\\nabla .\n\\end{gathered}\n}",
      "source_document": "derivation/DERIVATION_KO.md",
      "source_document_sha256": "7842931e332fcf7a4548e5741bd976f8d1d2e841971896bac0bc444d54dd1432"
    },
    {
      "id": "ABF.16",
      "latex": "\\boxed{\n\\begin{gathered}\nD_s^{(w)}:=-w\\cdot N_s\n=\\gamma_wD_s(1-v\\cdot\\beta_s),\\\\\nD_B^{(w)}:= -w\\cdot B\n=\\gamma_wD_B(1-v\\cdot\\beta_B),\\\\\nY_s^{(w)}:=\\frac{D_s^{(w)}}{D_B^{(w)}}\n=Y_s\\frac{1-v\\cdot\\beta_s}{1-v\\cdot\\beta_B},\n\\qquad \\sum_sb_sY_s^{(w)}=1 .\n\\end{gathered}\n}",
      "source_document": "derivation/DERIVATION_KO.md",
      "source_document_sha256": "7842931e332fcf7a4548e5741bd976f8d1d2e841971896bac0bc444d54dd1432"
    },
    {
      "id": "ABF.17",
      "latex": "\\boxed{\nD_B^{(w)}\\mathscr D_wY_s^{(w)}\n=R_s-c\\left[\nJ_B^{(w)a}D_a^{(w)}Y_s^{(w)}\n+D_a^{(w)}K_s^{(w)a}\n+\\mathfrak a_{w,a}K_s^{(w)a}\n\\right],\n\\qquad \\mathscr D_w=c\\,w\\cdot\\nabla .\n}",
      "source_document": "derivation/DERIVATION_KO.md",
      "source_document_sha256": "7842931e332fcf7a4548e5741bd976f8d1d2e841971896bac0bc444d54dd1432"
    },
    {
      "id": "ABF.18",
      "latex": "\\begin{gathered}\nN_s'=\\Lambda N_s,\n\\quad B'=\\Lambda B,\n\\quad u_s'=\\Lambda u_s,\n\\quad w'=\\Lambda w,\n\\quad Q_s'=\\Lambda Q_s,\n\\quad R_s'=R_s,\\\\\n\\omega'=\\Lambda\\omega\\Lambda^{-1}-d\\Lambda\\Lambda^{-1},\n\\qquad\nr_s'=r_s,\\quad X_s'=X_s,\\quad\n\\Gamma_{sr}'=\\Gamma_{sr},\\quad\nY_s^{(w)\\prime}=Y_s^{(w)} .\n\\end{gathered}",
      "source_document": "derivation/DERIVATION_KO.md",
      "source_document_sha256": "7842931e332fcf7a4548e5741bd976f8d1d2e841971896bac0bc444d54dd1432"
    },
    {
      "id": "ABF.19",
      "latex": "\\begin{gathered}\n\\dot\\vartheta_s=\\mathcal M_s^{-1}\\mathcal F_s,\n\\qquad\n\\dot{\\ln\\gamma_s}\n=\\partial_{\\vartheta_s}\\ln\\gamma_s\\cdot\n\\mathcal M_s^{-1}\\mathcal F_s,\\\\\n\\dot\\beta_B=\\frac{\\dot J_B-\\beta_B\\dot D_B}{D_B},\n\\quad\n\\dot J_B=\\sum_sb_s(\\dot D_s\\beta_s+D_s\\dot\\beta_s),\n\\quad\n\\dot{\\ln\\gamma_B}=\\gamma_B^2\\beta_B\\cdot\\dot\\beta_B,\\\\\n\\dot{\\ln\\Gamma_{sB}}\n=\\dot{\\ln\\gamma_s}+\\dot{\\ln\\gamma_B}\n-\\frac{\\dot\\beta_s\\cdot\\beta_B+\\beta_s\\cdot\\dot\\beta_B}\n{1-\\beta_s\\cdot\\beta_B} .\n\\end{gathered}",
      "source_document": "derivation/DERIVATION_KO.md",
      "source_document_sha256": "7842931e332fcf7a4548e5741bd976f8d1d2e841971896bac0bc444d54dd1432"
    },
    {
      "id": "ABF.20",
      "latex": "\\begin{gathered}\n\\mathcal S[U_s]:=\\frac1c(R_s,\\mathcal E_s,\\mathcal P_{s,i}),\n\\qquad\n\\mathcal E_s=-n\\cdot Q_s,\n\\quad \\mathcal P_s=h(n)Q_s,\\\\\n\\kappa_s:=\\mathcal S[\\ln\\gamma_s],\n\\quad \\kappa_B:=\\mathcal S[\\ln\\gamma_B],\n\\quad \\kappa_{sB}:=\\mathcal S[\\ln\\Gamma_{sB}],\n\\qquad\n\\mathcal S[D_B]=0,\n\\quad \\mathcal S[Y_s]=R_s/(cD_B),\\\\\n\\mathcal S[\\beta_B]=\\frac1{D_B}\\sum_sb_s\n\\left[\\beta_s\\frac{R_s}{c}+D_s\\mathcal S[\\beta_s]\\right],\n\\quad \\mathcal S[\\beta_s]\n=\\partial_{\\vartheta_s}\\beta_s\\,\n\\mathcal M_s^{-1}\\frac{(R_s,\\mathcal E_s,\\mathcal P_s)}c .\n\\end{gathered}",
      "source_document": "derivation/DERIVATION_KO.md",
      "source_document_sha256": "7842931e332fcf7a4548e5741bd976f8d1d2e841971896bac0bc444d54dd1432"
    },
    {
      "id": "ABF.21",
      "latex": "\\boxed{\n\\begin{aligned}\n\\mathcal S[r_s]\n&=\\frac{R_s}{c\\gamma_sn_B}+r_s(\\kappa_B-\\kappa_s),\\\\\n\\mathcal S[X_s]\n&=X_s(-\\kappa_s+\\langle\\kappa\\rangle_X)\n+\\frac{b_sR_s/\\gamma_s-X_s\\Xi}{cn_*},\\\\\n\\mathcal S[z_s]\n&=\\frac{R_s}{c\\gamma_s\\Gamma_{sB}n_B}\n+z_s(\\kappa_B-\\kappa_s-\\kappa_{sB}),\n\\qquad \\langle\\kappa\\rangle_X=\\sum_sX_s\\kappa_s .\n\\end{aligned}\n}",
      "source_document": "derivation/DERIVATION_KO.md",
      "source_document_sha256": "7842931e332fcf7a4548e5741bd976f8d1d2e841971896bac0bc444d54dd1432"
    },
    {
      "id": "ABF.22",
      "latex": "\\begin{gathered}\n\\mu_s=k_BT_s\\log\\frac{n_s}{Z_s(T_s)}\n=k_BT_s\\log\\frac{D_BY_s}{\\gamma_sZ_s(T_s)},\\\\\n\\mathcal H_s=-u_s\\cdot Q_s,\n\\qquad\n\\Sigma_s=\\frac{\\mathcal H_s-\\mu_sR_s}{T_s},\n\\qquad\n\\mathcal E_s=\\gamma_s\\mu_sR_s+\\gamma_sT_s\\Sigma_s\n+\\beta_s\\cdot\\boldsymbol f_s^{(n)} .\n\\end{gathered}",
      "source_document": "derivation/DERIVATION_KO.md",
      "source_document_sha256": "7842931e332fcf7a4548e5741bd976f8d1d2e841971896bac0bc444d54dd1432"
    },
    {
      "id": "ABF.23",
      "latex": "\\boxed{\n\\begin{aligned}\n\\dot e_{sB}^{(n)}\n&=\\frac{-3Hp_s^{(n)}-\\sigma:\\pi_s^{(n)}}{D_B}\n+\\frac{2a_B\\cdot(q_s-e_{sB}^{(n)}J_B)}{D_B}\n+\\frac{\\mathcal E_s}{cD_B},\\\\\n\\frac{\\mathcal E_s}{cD_B}\n&=\\gamma_s\\mu_s\\mathcal S[Y_s]\n+\\frac{\\gamma_sT_s\\Sigma_s+\\beta_s\\cdot\\boldsymbol f_s^{(n)}}{cD_B}.\n\\end{aligned}\n}",
      "source_document": "derivation/DERIVATION_KO.md",
      "source_document_sha256": "7842931e332fcf7a4548e5741bd976f8d1d2e841971896bac0bc444d54dd1432"
    },
    {
      "id": "ABF.24",
      "latex": "\\boxed{\n\\begin{gathered}\ns_B=\\sum_sY_s\\bar s_s,\n\\qquad\n\\dot s_B\n=\\frac{\\Sigma_{\\rm tot}}{cD_B}\n+\\frac{2a_B\\cdot(J_S-s_BJ_B)}{D_B},\\\\\n\\Sigma_{\\rm tot}=\\sum_s\\Sigma_s\n=k_B\\int(A_f-B_f)\\log(A_f/B_f)\\,d\\mathcal K\\ge0\n\\quad\\text{(MTF paired family)} .\n\\end{gathered}\n}",
      "source_document": "derivation/DERIVATION_KO.md",
      "source_document_sha256": "7842931e332fcf7a4548e5741bd976f8d1d2e841971896bac0bc444d54dd1432"
    },
    {
      "id": "ABF.25",
      "latex": "\\begin{gathered}\n\\sum_sb_s\\nu_{s\\alpha}=0,\n\\qquad \\sum_sq_s\\nu_{s\\alpha}=0,\n\\qquad\nJ_q^a:=\\sum_sq_sN_s^a,\n\\qquad \\nabla_aJ_q^a=0,\\\\\nY_q:=\\frac{-n\\cdot J_q}{D_B}=\\sum_sq_sY_s,\n\\qquad\n\\boxed{\\dot Y_q=\\frac{2a_B\\cdot[J_q^{(n)}-Y_qJ_B]}{D_B}},\n\\quad J_q^{(n)}:=h(n)J_q .\n\\end{gathered}",
      "source_document": "derivation/DERIVATION_KO.md",
      "source_document_sha256": "7842931e332fcf7a4548e5741bd976f8d1d2e841971896bac0bc444d54dd1432"
    },
    {
      "id": "ABF.26",
      "latex": "\\begin{gathered}\nR_s=\\nu_s\\mathcal R,\n\\qquad \\nu=(-1,-1,1,1),\\\\\n\\mathcal R=k_+(T_1,u_1;T_2,u_2)n_1n_2\n-k_-(T_3,u_3;T_4,u_4)n_3n_4,\\\\\nk_+=\\int\\phi_1\\phi_2\\,d\\mathcal K>0,\n\\qquad k_-=\\int\\phi_3\\phi_4\\,d\\mathcal K>0,\\\\\n\\frac{\\mathcal R}{cD_B}\n=\\frac{D_B}{c}\\left[\nk_+\\frac{Y_1Y_2}{\\gamma_1\\gamma_2}\n-k_-\\frac{Y_3Y_4}{\\gamma_3\\gamma_4}\\right].\n\\end{gathered}",
      "source_document": "derivation/DERIVATION_KO.md",
      "source_document_sha256": "7842931e332fcf7a4548e5741bd976f8d1d2e841971896bac0bc444d54dd1432"
    },
    {
      "id": "ABF.27",
      "latex": "\\begin{gathered}\nA_s(s):=2a_B\\cdot(\\beta_s-\\beta_B)-\\ell_s/(c\\gamma_s),\n\\qquad \\dot Y_s=A_sY_s+G_s/(cD_B),\\\\\n\\boxed{\nY_s(s)=e^{\\int_{s_0}^sA_s(v)\\,dv}\n\\left[Y_s(s_0)+\\int_{s_0}^s\ne^{-\\int_{s_0}^uA_s(v)\\,dv}\n\\frac{G_s(u)}{cD_B(u)}\\,du\\right]>0\n\\quad(s\\ge s_0).\n}\n\\end{gathered}",
      "source_document": "derivation/DERIVATION_KO.md",
      "source_document_sha256": "7842931e332fcf7a4548e5741bd976f8d1d2e841971896bac0bc444d54dd1432"
    },
    {
      "id": "ABF.28",
      "latex": "\\boxed{\nr_s=z_s=Y_s^{(B)}=Y_s,\\qquad X_s=b_sY_s,\n\\qquad\n\\dot Y_s=\\frac{R_s}{c\\gamma n_B},\n\\qquad\n\\mathscr D_uY_s=\\frac{R_s}{n_B},\n\\qquad \\Xi=\\gamma^{-1}\\sum_sb_sR_s=0 .\n}",
      "source_document": "derivation/DERIVATION_KO.md",
      "source_document_sha256": "7842931e332fcf7a4548e5741bd976f8d1d2e841971896bac0bc444d54dd1432"
    },
    {
      "id": "ABF.29",
      "latex": "\\boxed{\n\\mathfrak Y_s(\\Sigma)\n:=\\frac{\\mathcal N_s(\\Sigma)}{\\mathcal N_B(\\Sigma)}\n=\\frac{\\int_\\Sigma D_B^{(w)}Y_s^{(w)}\\,dV_\\Sigma}\n{\\int_\\Sigma D_B^{(w)}\\,dV_\\Sigma} .\n}\n\\qquad\n\\mathfrak F_s^{\\rm det}\n=\\frac{\\ell_aN_s^a}{\\ell_aB^a}\n\\quad(\\ell\\cdot B\\ne0).",
      "source_document": "derivation/DERIVATION_KO.md",
      "source_document_sha256": "7842931e332fcf7a4548e5741bd976f8d1d2e841971896bac0bc444d54dd1432"
    },
    {
      "id": "ABF.30",
      "latex": "\\boxed{\n\\begin{gathered}\n\\mathcal N_B(\\Sigma_2)=\\mathcal N_B(\\Sigma_1),\\\\\n\\mathfrak Y_s(\\Sigma_2)-\\mathfrak Y_s(\\Sigma_1)\n=\\frac{1}{\\mathcal N_B}\\left[\n\\int_{\\mathcal V}\\frac{R_s}{c}\\,dV_4\n-\\int_{\\mathrm{side}}N_s^a\\,d\\Sigma_a\\right].\n\\end{gathered}\n}",
      "source_document": "derivation/DERIVATION_KO.md",
      "source_document_sha256": "7842931e332fcf7a4548e5741bd976f8d1d2e841971896bac0bc444d54dd1432"
    }
  ],
