#![forbid(unsafe_code)]
#[path="../bass/research/bass_isotropy_response_20261018/balance.rs"] mod balance;
#[path="../bass/research/bass_isotropy_response_20261018/native_adapter.rs"] mod adapter;
use rei_microphysics::axbi_covariant_transport::CovariantTransport;
use rei_microphysics::axbi_sources::AxbiSource;
use rei_microphysics::{AxisymmetricPoint,GeometrySnapshot};
fn main() {
    let a=1.0/21.0;
    let source=AxbiSource::new(1.88e-7,0.2,16,8).unwrap();
    let g0=GeometrySnapshot::new([a;3],[1e-16;3]).unwrap();
    let g=AxisymmetricPoint::new(a*0.5_f64.exp(),0.2,1e-16,1e-18).unwrap().snapshot().unwrap();
    let t=CovariantTransport::new(&source,g0,96,0.01,5000.0).unwrap();
    let rays=t.ray_geometry(&g).unwrap();let m:Vec<_>=rays.iter().map(|x|x.mu).collect();
    let q:Vec<_>=rays.iter().map(|x|x.angular_weight).collect();
    let w=balance::project(&m,&q,3e-15).unwrap().weights;
    let mut s=t.empty_state();t.add_delta(&mut s,0,1.0,0.01).unwrap();
    let before=t.inventory(&s,&g).unwrap();
    let r=adapter::inject_new_isotropic(&t,&mut s,&g,21.0*(-0.5_f64).exp()-1.0,1e12,
        adapter::Declaration::locally_isotropic_non_tilted(),adapter::Constraints::P2,&w).unwrap();
    let after=t.inventory(&s,&g).unwrap();
    let dn=after.0-before.0-r.added.added_photons_per_h;
    let du=after.1-before.1-r.added.added_energy_ev_per_h;
    assert!(dn.abs()/r.added.added_photons_per_h<1e-11);
    assert!(du.abs()/r.added.added_energy_ev_per_h<1e-11);
    println!("{{\"status\":\"PASS_P2_NATIVE_ADAPTER_PREFLIGHT\",\"b\":0.2,\"n_mu\":8,\"n_energy\":96,\"weight_m2\":{:.17e},\"weight_m4\":{:.17e},\"energy_m2\":{:.17e},\"energy_m4\":{:.17e},\"ledger_n_residual\":{:.17e},\"ledger_u_residual\":{:.17e}}}",r.weight_moments[0],r.weight_moments[1],r.energy_moments[0],r.energy_moments[1],dn,du);
}
