+                self.close(up.number_rate_m3_s,direct['gross_escaped_up_m3_s'],direct['gross_escaped_down_m3_s']+direct['gross_escaped_up_m3_s'])
+                self.close(net.cQ_J_m3_s[0],direct['du_radiation_J_m3_s'],scale)
