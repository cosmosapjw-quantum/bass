+    /// Direct physical energy defect in eV/H, computed from stock differences.
+    /// Same frozen photon energies, fixed densities and proper interval as evaluate().
+    fn energy_defect(
+        &self, old: &DriverState, unknown: [f64; 4], stocks: &[f64],
+        rhs: &IgmPointRhs, dt: f64,
+    ) -> Result<f64, ForwardError> {
+        let c = HHeModel::controlled_fixture();
+        let nh = self.input.n_h_cm3;
+        let fhe = self.input.n_he_cm3 / nh;
+        let d = std::array::from_fn::<_, 3, _>(|i| unknown[i] - old.gas.fractions[i]);
+        let db = c.threshold_ev[0]*d[0] + fhe*(c.threshold_ev[1]*d[1]
+            + (c.threshold_ev[1]+c.threshold_ev[2])*d[2]);
+        // Neumaier sum of actual absorption energies, no total-inventory subtraction.
+        let (mut u, mut corr) = (0_f64,0_f64);
+        let ne = self.energies.len();
+        for (j, (&a,&b)) in old.photons.iter().zip(stocks).enumerate() {
+            let x = (a-b)*self.energies[j % ne];
+            let t = u+x;
+            corr += if u.abs() >= x.abs() {(u-t)+x} else {(x-t)+u};
+            u=t;
+        }
+        let dw = w_erg_per_h_to_ev(w_ev_per_h_to_erg(unknown[3])?)?
+            - w_erg_per_h_to_ev(old.gas.w_erg_per_h)?;
+        f(dw+db-(u+corr)+rhs.escape_erg_cm3_s*dt/(nh*c.ev_erg)
+            -rhs.cmb_to_gas_erg_cm3_s*dt/(nh*c.ev_erg))
+    }
+    fn merit(&self, old: &DriverState, x: [f64;4], r: [f64;4],
+             stocks: &[f64], rhs: &IgmPointRhs, dt:f64, old_w:f64)
+             -> Result<f64,ForwardError> {
+        let norm=self.norm(r,old_w,x[3]);
+        if let Some(b)=self.energy_budget {
+            f((norm/1e-11).max(self.energy_defect(old,x,stocks,rhs,dt)?.abs()/b))
+        } else {
+            Ok(norm)
+        }
+    }
