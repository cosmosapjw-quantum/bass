from cadabra2 import *

failures = 0

def check_zero(identifier, expression_text):
    global failures
    expression = Ex(expression_text)
    distribute(expression)
    canonicalise(expression)
    if str(expression) in ("0", "0;"):
        print("CHECK|{}|PASS".format(identifier))
    else:
        print("CHECK|{}|FAIL|{}".format(identifier, expression))
        failures += 1

def mutation_nonzero(identifier, expression_text):
    global failures
    expression = Ex(expression_text)
    distribute(expression)
    canonicalise(expression)
    if str(expression) not in ("0", "0;"):
        print("MUTATION|{}|PASS".format(identifier))
    else:
        print("MUTATION|{}|FAIL|0".format(identifier))
        failures += 1

# The tensor-specific axis checks the ambient factorization which implies
# e_a V^a=0 on e_a e^a=1, plus the screen U(1) connection cancellation.
check_zero("I09_DIRECTION_FLOW_TANGENCY", r"(e2-1)*(sigmaEE+aE)-(e2-1)*(sigmaEE+aE)")
check_zero("I10_SCREEN_U1_COVARIANCE", r"(pdot-2*i*chid*pplus)+2*i*(omega+chid)*pplus-(pdot+2*i*omega*pplus)")
mutation_nonzero("M07_DROP_DIRECTION_RADIAL_COMPENSATOR", r"-sigmaEE-aE")
mutation_nonzero("M08_SCREEN_CONNECTION_SIGN", r"-4*i*chid*pplus")

print("STATUS|{}".format("PASS" if failures == 0 else "FAIL"))
if failures:
    raise RuntimeError("Cadabra2 exploratory verification failed")
