    {"name": "A0_BACKGROUND_BUDGET_V1", "kind": "constant", "record_type": "ResidualBudget"},
    {"name": "FLRWPoint", "kind": "frozen_record_constructor", "record_type": "FLRWPoint"},
    {"name": "evaluate_flrw_residuals", "kind": "function", "signature": "(point: FLRWPoint, *, constants: PhysicalConstants = CODATA_2022) -> FLRWResidualSet"},
    {"name": "check_flrw_residuals", "kind": "function", "signature": "(residuals: FLRWResidualSet, *, budget: ResidualBudget = A0_BACKGROUND_BUDGET_V1) -> ResidualCheckSet"},
    {"name": "canonical_bytes", "kind": "function", "signature": "(record: CanonicalRecord) -> bytes"},
    {"name": "content_sha256", "kind": "function", "signature": "(record: CanonicalRecord) -> str"}
  ],
  "records": {
    "ConventionSpec": [
