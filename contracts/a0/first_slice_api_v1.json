    {"name": "get_conventions", "kind": "function", "signature": "() -> ConventionSpec"},
    {"name": "list_families", "kind": "function", "signature": "() -> tuple[FamilySpec, ...]"},
    {"name": "select_family", "kind": "function", "signature": "(family_id: FamilyID, *, h: Fraction | float | numpy.float64 | None = None) -> FamilySelection"},
    {"name": "capabilities", "kind": "function", "signature": "() -> CapabilitySnapshot"},
