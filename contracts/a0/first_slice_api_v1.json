  "exceptional_branches": [{"id": "VI_-1/9", "parent": "VI_h", "h": {"numerator": "-1", "denominator": "9"}}],
  "enums": {
    "CapabilityState": ["READY", "LOCKED_PENDING_EVIDENCE", "OUT_OF_SCOPE"],
    "CheckStatus": ["PASS", "FAIL"],
    "ResidualChannelID": ["HAMILTONIAN", "CONTINUITY", "RAYCHAUDHURI"]
  },
  "symbols": [
