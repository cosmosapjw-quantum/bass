      ["status", "CheckStatus", null], ["residuals_sha256", "str", null], ["budget_sha256", "str", null],
      ["checks", "tuple[ResidualCheck, ...]", null],
      ["failed_channels", "tuple[ResidualChannelID, ...]", null]
    ]
  },
  "constants": {
    "CODATA_2022": {
      "c_m_s": 299792458.0,
      "G_m3_kg_s2": 6.6743e-11,
      "G_standard_uncertainty_m3_kg_s2": 1.5e-15,
      "codata_year": 2022,
      "source_uri": "https://physics.nist.gov/cuu/pdf/JPCRD2022CODATA.pdf"
    },
    "A0_BACKGROUND_BUDGET_V1": {
      "hamiltonian_atol_s_inv2": 0.0,
      "continuity_atol_J_m3_s": 0.0,
      "raychaudhuri_atol_s_inv2": 0.0,
      "rtol_expression": "1024 * 2^-53"
    }
  },
  "scalar_policy": {
    "accepted_real_types": ["builtins.float", "numpy.float64"],
    "rejected": ["bool", "int", "str", "complex", "numpy.float32", "nonfinite", "subclass", "nonzero_subnormal"],
    "negative_zero": "canonicalize_to_positive_zero",
    "storage": "little_endian_ieee754_binary64_copy"
  },
  "family_dispatch": {
    "special_value_type": "fractions.Fraction_positive_denominator",
    "VI_h": {"domain": "real h < 0", "exact_alias": "-1 -> III", "exact_exception": "-1/9 -> VI_-1/9", "exact_boundary": "0 rejected; use VI_0"},
    "VII_h": {"domain": "real h > 0", "exact_boundary": "0 rejected; use VII_0"},
    "binary64_policy": "generic_parameter_only_never_special_dispatch",
    "reserved_binary64_values": [-1.0, 0.0],
    "proximity_dispatch": false
  },
  "exception_hierarchy": [
    "BASSError", "ConventionError", "ShapeTypeError", "DomainError", "ConstraintViolation",
    "IntegrationFailure", "ConvergenceFailure", "UnsupportedSector", "BackendMismatch"
  ],
  "first_slice_error_map": {
    "ConventionError": ["E_CONVENTION_ID", "E_FRAME_UNRESOLVED", "E_PARITY_UNRESOLVED"],
    "ShapeTypeError": ["E_TYPE", "E_DTYPE", "E_SHAPE", "E_SUBCLASS", "E_NONFINITE", "E_SUBNORMAL_UNSUPPORTED", "E_IMMUTABLE", "E_SERIALIZATION_CONTRACT", "E_CONTENT_HASH"],
    "DomainError": ["E_FAMILY_ID", "E_H_REQUIRED", "E_H_FORBIDDEN", "E_H_DOMAIN", "E_H_SPECIAL_FLOAT", "E_TIME_DOMAIN", "E_CONSTANT_DOMAIN"],
    "UnsupportedSector": ["E_SECTOR_LOCKED", "E_SECTOR_OUT_OF_SCOPE"]
  },
  "finite_residual_miss": "return_FAIL_not_exception",
  "a0_pass_hash_requirements": [
    "FLRWResidualSet.constants_sha256 == content_sha256(CODATA_2022)",
    "ResidualCheckSet.residuals_sha256 == content_sha256(FLRWResidualSet)",
    "ResidualCheckSet.budget_sha256 == content_sha256(A0_BACKGROUND_BUDGET_V1)"
  ],
  "error_metadata_allowlist": ["field", "expected", "received_type", "shape", "unit_id", "family_id", "branch_id", "contract_id"],
  "error_metadata_max_unicode_scalars": 256,
  "canonical_frame": {
    "prefix_ascii_nul_terminated": "BASS-CANONICAL-v1",
    "layout": "prefix_with_NUL || uint64_be(metadata_length) || metadata_json || uint64_be(payload_length) || payload",
    "metadata": {"encoding": "UTF-8", "unicode": "NFC", "sort_keys": true, "separators": [",", ":"], "allow_nan": false, "floating_values_allowed": false},
    "payload": {"dtype": "<f8", "record_field_order": true, "negative_zero": "positive_zero"},
    "fraction_metadata": "signed_decimal_numerator_and_positive_decimal_denominator_strings",
    "unknown_or_duplicate_fields": "reject",
    "trailing_bytes": "reject",
    "hash": "SHA-256_complete_frame_lowercase_hex"
  }
}
