      ["kinematic_expansion_id", "str", null], ["adm_relation_id", "str", null],
      ["structure_id", "str", null], ["units_id", "str", null]
    ],
    "FamilySpec": [
      ["family_id", "FamilyID", null], ["class_id", "str", null], ["h_kind", "str", null],
      ["h_domain", "str | None", null], ["aliases", "tuple[str, ...]", null],
      ["exceptional_branches", "tuple[str, ...]", null], ["capabilities", "CapabilitySnapshot", null]
    ],
    "FamilySelection": [
      ["requested_id", "FamilyID", null], ["canonical_id", "FamilyID", null], ["branch_id", "str", null],
      ["h_exact", "Fraction | None", null], ["h_binary64", "float | None", null],
      ["registry_only", "bool", null], ["frame_parity", "str | None", null]
    ],
