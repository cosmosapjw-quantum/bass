{
  "schema_version": 1,
  "contract_id": "bass.characterization.a0.background.v1",
  "unit_roundoff": {"expression": "2^-53", "hex_binary64": "0x1.0000000000000p-53"},
  "dimensionless_guard": {
    "formula": "abs(error) <= 64*u + 256*u*reference_scale",
    "reference_scale": "max(1, fsum(abs(reference_term_i)))",
    "term_list_must_be_declared": true
  },
  "background_budget": {
    "budget_id": "A0_BACKGROUND_BUDGET_V1",
    "atol": {
      "HAMILTONIAN": {"value": 0.0, "unit": "s^-2"},
      "CONTINUITY": {"value": 0.0, "unit": "J m^-3 s^-1"},
      "RAYCHAUDHURI": {"value": 0.0, "unit": "s^-2"}
    },
    "rtol": {"expression": "1024*2^-53 = 2^-43", "hex_binary64": "0x1.0000000000000p-43", "decimal": 1.1368683772161603e-13},
    "claim_policy": "Only this exact budget may support an A0 characterization claim."
  },
  "residual_channels": [
    {
      "id": "HAMILTONIAN",
      "equation_id": "A0-EQ-BG-001",
      "unit": "s^-2",
      "ordered_terms": [
        "3*H_s_inv^2",
        "(c_m_s^2/2)*R3_m_inv2",
        "-(8*pi*G_m3_kg_s2/c_m_s^2)*rho_energy_J_m3",
        "-Lambda_m_inv2*c_m_s^2"
      ]
    },
    {
      "id": "CONTINUITY",
      "equation_id": "A0-EQ-FLRW-001",
      "unit": "J m^-3 s^-1",
      "ordered_terms": [
        "d_rho_energy_dt_J_m3_s",
        "3*H_s_inv*rho_energy_J_m3",
        "3*H_s_inv*pressure_J_m3"
      ]
    },
    {
      "id": "RAYCHAUDHURI",
      "equation_id": "A0-EQ-FLRW-002",
      "unit": "s^-2",
      "ordered_terms": [
        "dH_dt_s_inv2",
        "(4*pi*G_m3_kg_s2/c_m_s^2)*rho_energy_J_m3",
        "(4*pi*G_m3_kg_s2/c_m_s^2)*pressure_J_m3",
        "-(c_m_s^2/6)*R3_m_inv2"
      ]
    }
  ],
  "evaluation": {
    "residual_sum": "math.fsum(ordered_terms)",
    "reference_scale": "math.fsum(abs(term) for term in ordered_terms)",
    "zero_scale": "PASS iff raw_value == 0.0 under atol=0; relative_value=null",
    "nonzero_scale": "PASS iff abs(raw_value) <= atol + rtol*reference_scale; relative_value=abs(raw_value)/reference_scale",
    "aggregate": "PASS iff every channel PASS",
    "empty_terms": "raise E_SERIALIZATION_CONTRACT",
    "nonfinite_or_overflow": "raise E_NONFINITE",
    "nonzero_subnormal_input_or_term": "raise E_SUBNORMAL_UNSUPPORTED",
    "underflow_to_zero": "raise E_SUBNORMAL_UNSUPPORTED",
    "negative_zero_hashing": "canonicalize_to_positive_zero"
  },
  "geometry_cases": [
